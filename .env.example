# --- Required ---------------------------------------------------------------

# MongoDB connection string. Atlas (mongodb+srv://...) or self-hosted. A replica set
# (Atlas always is) enables multi-document transactions; a standalone server also works.
MONGODB_URI=mongodb://127.0.0.1:27017/biios_pm

# Better Auth: a random secret of 32+ characters (openssl rand -base64 32) and the public URL.
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# --- Optional ---------------------------------------------------------------

# Sign-up: the first account becomes the admin. After that only admins add people,
# unless this is "true".
ALLOW_OPEN_SIGNUP=false

# --- Google sign-in (optional) ---
# "Continue with Google" appears when both are set. Create an OAuth client (Web application) in
# Google Cloud Console; add <BETTER_AUTH_URL>/api/auth/callback/google as an authorized redirect URI.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# New accounts through Google only for these company domains (comma-separated). People an admin
# already added can use Google with any email. Empty = Google only for people an admin added.
# GOOGLE_ALLOWED_DOMAINS=biios.in

# Extra origins allowed to sign in (comma-separated), e.g. a custom domain.
# TRUSTED_ORIGINS=https://pm.biios.in

# --- File storage (receipts, documents, attachments) ---
# On a server or Docker: local disk. Defaults to ./storage (/data/storage in Docker).
# STORAGE_DIR=/var/lib/biios-pm/storage
#
# On Vercel (no persistent disk): Cloudinary, recommended. Copy "API environment variable" from the
# Cloudinary console (Settings > API Keys). Files are stored as private (authenticated) assets.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_FOLDER=biios-pm
#
# Or an S3-compatible bucket.
# Setting S3_BUCKET switches storage to it. Files stay private; the app streams them to signed-in users.
# Cloudflare R2 example:
# S3_BUCKET=biios-pm-files
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# AWS S3: leave S3_ENDPOINT empty and set S3_REGION (e.g. ap-south-1).
# MinIO and other self-hosted S3: also set S3_FORCE_PATH_STYLE=true.

# Recurring expenses: a long-running server posts them every 30 minutes. On Vercel, Vercel Cron
# calls /api/cron/recurring daily (vercel.json) and needs CRON_SECRET. Set RECURRING_SCHEDULER=off
# when another external scheduler calls it with "Authorization: Bearer $CRON_SECRET".
# RECURRING_SCHEDULER=on
# CRON_SECRET=a-long-random-secret

# GST state code of the company (decides CGST+SGST vs IGST). 27 = Maharashtra.
# NEXT_PUBLIC_COMPANY_STATE_CODE=27
